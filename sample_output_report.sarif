                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "secret",
                  "credential",
                  "devsecops"
                ],
                "precision": "high",
                "severity": "CRITICAL",
                "confidence": "HIGH"
              }
            },
            {
